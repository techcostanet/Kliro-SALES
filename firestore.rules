rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar: Usuário autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Mapeamento de usuário para empresa (Tenant)
    match /user_mappings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Regras Multi-Tenant para as Empresas
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Para setup inicial

      // Subcoleção de Usuários
      match /users/{userId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Produtos (Catálogo)
      match /products/{productId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Clientes (Salões e Barbearias)
      match /clients/{clientId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Rotas
      match /routes/{routeId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Agendamentos de Rotas (Calendário)
      match /route_schedules/{scheduleId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Contas a Pagar (Payables)
      match /payables/{payableId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Contas a Receber (Receivables / P.A.)
      match /receivables/{receivableId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Configurações da Empresa (Branding e Dados)
      match /settings/{settingId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Categorias Financeiras
      match /categories/{categoryId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Cargas (Carregamento de Rotas)
      match /loads/{loadId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Condições de Pagamento
      match /payment_terms/{termId} {
        allow read, write: if isAuthenticated();
      }

      // Subcoleção de Logs de Atividades do Sistema (Audit Trail Imutável)
      match /activity_logs/{logId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if false; // Anti-Fraude: Logs de auditoria são imutáveis
      }

      // Subcoleção de Execuções de Rotas (Modo Rua)
      match /route_executions/{executionId} {
        allow read: if isAuthenticated();
        // Permite abrir rota
        allow create: if isAuthenticated();
        // Permite atualizar para fechar (CLOSED), mas impede reabrir rota já fechada (Anti-Fraude)
        allow update: if isAuthenticated() && (
          resource.data.status != 'CLOSED' || request.resource.data.status == 'CLOSED'
        );
        allow delete: if false; // Ninguém pode apagar histórico de rota
      }

      // Subcoleção de Transações (Vendas, Pagamentos, Devoluções)
      match /transactions/{transactionId} {
        allow read: if isAuthenticated();
        // Anti-Fraude: Permite criar vendas durante a rota
        allow create: if isAuthenticated();
        // Anti-Fraude: Impede edição ou exclusão de transações já salvas
        allow update, delete: if false;
      }
    }
  }
}
